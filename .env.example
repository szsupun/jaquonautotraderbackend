# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real secrets. Every setting here can also be provided as a
# plain OS environment variable instead (useful on most hosting platforms).

# ============================================================================
# TELEGRAM BOT
# ============================================================================
# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to see the admin dashboard.
# Find your own ID by messaging @userinfobot on Telegram.
TELEGRAM_ADMIN_IDS=

# ============================================================================
# DATABASE (MongoDB)
# ============================================================================
# Connection string — a local mongod (mongodb://localhost:27017) or a
# MongoDB Atlas cluster (mongodb+srv://user:pass@cluster.mongodb.net).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=autotrader

# ============================================================================
# MINI APP
# ============================================================================
# The deployed frontend URL (e.g. Vercel). Telegram WebApps require HTTPS —
# leave blank to hide the "Open App" button until this is set.
MINIAPP_URL=

# Origins allowed to call this API (CORS), comma-separated.
# e.g. https://your-app.vercel.app — "*" is fine for local dev only.
FRONTEND_ORIGINS=*

# ============================================================================
# ACCESS CONTROL
# ============================================================================
# Comma-separated Telegram user IDs allowed to use the app at all.
# Leave blank to let any Telegram user in (open beta).
ALLOWED_USER_IDS=

# Only set to true when running purely on localhost with no public tunnel —
# see the warning in config.py before touching this in any real deployment.
DEV_BYPASS_AUTH=false

# ============================================================================
# CAPACITY / TUNING (safe to leave at defaults)
# ============================================================================
MAX_CONCURRENT_TRADERS=25
MAX_CONCURRENT_CONNECTS=5
CONNECT_JITTER_MAX_SECONDS=4.0
ASSET_LOAD_WAIT_SECONDS=20
LOG_LEVEL=INFO
